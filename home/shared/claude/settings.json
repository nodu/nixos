      "Bash(git -C ~/repos/raiz/10four-app worktree add --detach ~/repos/raiz/10four-app-worktrees-pr-reviews/pr-*)",
      "Bash(git checkout --detach FETCH_HEAD)",
      "Bash(echo *)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git rev-parse *)",
      "Bash(git remote get-url origin)",
      "Bash(cd *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(jq *)",
      "Bash(date)",
      "Bash(date *)",
      "Bash(mkdir -p ~/repos/raiz/10four-app-worktrees-pr-reviews/*)",
      "Bash(python3 -m json.tool *)",
      "Bash(npm test)",
      "Bash(npm test *)",
      "Bash(npm run test *)",
      "Bash(npx vitest *)",
      "Bash(npx jest *)",
      "Bash(pnpm test *)",
      "Bash(pytest *)",
      "Bash(uv run pytest)",
      "Bash(uv run pytest *)",
      "Bash(git fetch *)",
      "Bash(git ls-remote *)",
      "Bash(kubectl get *)",
      "Bash(kubectl describe *)",
      "Bash(kubectl logs *)",
      "Bash(kubectl top *)",
      "Bash(helm list *)",
      "Bash(helm status *)",
      "Bash(helm get *)",
      "Bash(helm history *)",
      "Bash(terraform validate *)",
      "Bash(terraform show *)",
      "Bash(terraform output *)",
      "Bash(terraform state list *)",
      "Bash(terraform providers)",
      "Bash(terraform version)",
      "Bash(gcloud auth list)",
      "Bash(gcloud config list *)",
      "Bash(gcloud secrets list *)",
      "Bash(gcloud container clusters list *)",
      "Bash(npm run lint)",
      "Bash(make lint)",
      "Bash(aerospace list-windows *)",
      "Bash(aerospace list-workspaces *)",
      "Bash(aerospace list-monitors *)",
      "Bash(aerospace list-apps *)",
      "Bash(nix eval *)",
      "Bash(defaults read *)",
      "Bash(tmux ls *)",
      "Bash(tmux list-keys *)",
      "Bash(tmux list-windows *)",
      "Bash(tmux show-options *)",
      "Bash(tmux display *)",
      "Edit(~/repos/raiz/10four-app-worktrees-pr-reviews/**)",
