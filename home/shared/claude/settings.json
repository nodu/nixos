      "mcp__claude_ai_Linear__list_teams",
      "mcp__claude_ai_Linear__list_issues",
      "mcp__claude_ai_Linear__get_team",
      "mcp__claude_ai_Linear__get_release",
      "mcp__claude_ai_Notion__notion-fetch",
      "mcp__claude_ai_Notion__notion-search",
      "mcp__claude_ai_Linear__list_comments",
      "mcp__claude_ai_Linear__list_projects",
      "mcp__claude_ai_Linear__list_releases",
      "mcp__claude_ai_Linear__get_project",
      "mcp__claude_ai_Linear__list_issue_labels",
      "Read(~/repos/**)",
      "Read(~/.config/**)",
      "Read(~/.claude/**)",
      "Read(//nix/**)",
      "Read(//etc/nix/**)"
    ],
    "deny": [
      "Read(~/.config/gcloud/**)",
      "Read(~/.config/1Password/**)",
      "Read(~/repos/**/.env)",
      "Read(~/repos/**/.env.*)",
      "Read(~/repos/**/.envrc)",
      "Read(~/repos/**/*.pem)",
      "Read(~/repos/**/*.tfstate)",
      "Read(~/.claude/.credentials.json)",
      "Bash(gh pr review *)",
      "Bash(gh pr merge *)",
      "Bash(gh pr close *)",
      "Bash(git push *)",
      "Bash(git add)",
      "Bash(git add *)",
      "Bash(git stage)",
      "Bash(git stage *)"
    ],
    "defaultMode": "default",
    "additionalDirectories": [
      "~/repos/raiz"
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh"
  },
  "enabledPlugins": {
    "clangd-lsp@claude-plugins-official": true,
    "overroute-skills@overroute": true
  },
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    },
    "overroute": {
      "source": {
        "source": "github",
        "repo": "10four-ai/skills-prompts"
      },
      "autoUpdate": true
    }
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "allowUnsandboxedCommands": false,
    "network": {
      "allowedDomains": [
        "cache.nixos.org",
        "channels.nixos.org",
        "nix-community.cachix.org",
        "github.com",
        "api.github.com",
        "codeload.github.com",
        "*.githubusercontent.com",
        "registry.npmjs.org",
        "api.smith.langchain.com"
      ],
      "allowUnixSockets": [
        "/nix/var/nix/daemon-socket/socket"
      ],
      "allowLocalBinding": true
    },
    "filesystem": {
      "allowWrite": [
        "~/.cache/nix"
      ],
      "allowRead": [
        "~/repos/**/.env.example",
        "~/repos/**/.env.example.*"
      ]
    },
    "enableWeakerNetworkIsolation": true,
    "excludedCommands": [
      "ssh *",
      "gh",
      "gcloud",
      "terraform",
      "kubectl",
      "helm",
      "darwin-rebuild",
      "darwin-rebuild *",
      "sudo darwin-rebuild *",
      "nixos-rebuild *",
      "sudo nixos-rebuild *"
    ]
  },
  "tui": "fullscreen"
}
