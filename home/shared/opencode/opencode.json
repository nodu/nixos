        },
        "llama3.3": {
          "name": "llama3.3"
        },
        "qwen3.5:35b": {
          "name": "qwen3.5:35b"
        },
        "qwen3.6": {
          "name": "qwen3.6"
        }
      },
      "name": "Ollama",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://127.0.0.1:11434/v1"
      }
    }
  }
}
