{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "plan",
  "skills": {
    "paths": [
      "~/.claude/skills-overroute/skills"
    ]
  },
  "mcp": {
    "linear": {
      "type": "remote",
      "url": "https://mcp.linear.app/mcp"
    },
    "notion": {
      "type": "remote",
      "url": "https://mcp.notion.com/mcp"
    }
  },
  "provider": {
    "ollama": {
      "name": "Ollama (local)",
      "npm": "ollama-ai-provider-v2",
      "options": {
        "baseURL": "http://127.0.0.1:11434/api"
      },
      "models": {
        "gpt-oss:20b": {
          "name": "gpt-oss 20B — reasoning / diagnosis",
          "tools": true,
          "reasoning": true,
          "options": {
            "num_ctx": 65536
          },
          "limit": {
            "context": 65536,
            "output": 8192
          }
        },
        "qwen3.8:27b": {
          "name": "Qwen3.8 27B — best quality (slow, ~4 tok/s)",
          "tools": true,
          "reasoning": true,
          "attachment": true,
          "options": {
            "num_ctx": 65536
          },
          "limit": {
            "context": 65536,
            "output": 8192
          }
        },
        "qwen3.5:9b": {
          "name": "Qwen3.5 9B — general",
          "tools": true,
          "reasoning": true,
          "attachment": true,
          "options": {
            "num_ctx": 65536
          },
          "limit": {
            "context": 65536,
            "output": 8192
          }
        },
        "gemma4:12b": {
          "name": "Gemma 4 12B — prose / vision / audio",
          "tools": true,
          "reasoning": true,
          "attachment": true,
          "options": {
            "num_ctx": 65536
          },
          "limit": {
            "context": 65536,
            "output": 8192
          }
        },
        "qwen2.5-coder:7b": {
          "name": "Qwen2.5 Coder 7B — code / completion",
          "tools": true,
          "options": {
            "num_ctx": 32768
          },
          "limit": {
            "context": 32768,
            "output": 8192
          }
        },
        "qwen3.5:2b": {
          "name": "Qwen3.5 2B — fast / small",
          "tools": true,
          "reasoning": true,
          "attachment": true,
          "options": {
            "num_ctx": 32768
          },
          "limit": {
            "context": 32768,
            "output": 8192
          }
        },
        "qwen3:1.7b": {
          "name": "Qwen3 1.7B — tiny / fastest",
          "tools": true,
          "reasoning": true,
          "options": {
            "num_ctx": 32768
          },
          "limit": {
            "context": 32768,
            "output": 8192
          }
        }
      }
    }
  }
}
